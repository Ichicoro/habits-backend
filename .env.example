DJANGO_SECRET_KEY=CHANGE_THIS_PLEASE_:D
DEBUG=True
DJANGO_LOGLEVEL=info
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://habits.zelda.sh
# Origins the web build of the app is served from (comma-separated). Leave
# empty when there is no web client or it is served from this same host.
DJANGO_CORS_ALLOWED_ORIGINS=
DATABASE_NAME=habits_db
DATABASE_USERNAME=dbuser
DATABASE_PASSWORD=dbpassword
SENTRY_DSN=
# Kill switch for realtime websockets. Set to 0 to unmount the ws route and
# skip all broadcasts; clients fall back to refetch-on-mount and pull-to-refresh.
REALTIME_ENABLED=1
RESEND_API_KEY=
RESEND_FROM_EMAIL=Echoes <noreply@echoes.zelda.sh>